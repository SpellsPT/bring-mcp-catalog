# Bring! account credentials (required).
MAIL=your_email@example.com
PW=your_password

# Which catalog languages to index (optional).
#
# Resolution can only match a language it has indexed, so set this to the
# languages your household actually types in. de-DE is always included whether
# you list it or not, because Bring's canonical item ids ARE the German names.
#
#   default if unset:  de-DE,en-US
#   Portuguese house:  BRING_MCP_CATALOG_LOCALES=de-DE,pt-BR,en-US
#   French house:      BRING_MCP_CATALOG_LOCALES=de-DE,fr-FR
#
# An unsupported locale throws at startup rather than being skipped, so a typo
# is loud rather than a matcher that silently never recognises your words.
#BRING_MCP_CATALOG_LOCALES=de-DE,en-US

# Language that listItemCustomisations renders in (optional).
# Defaults to the first indexed locale that is not de-DE.
#BRING_MCP_DESCRIBE_LOCALE=en-US

# Enable the raw API escape hatch (optional, off by default).
#BRING_MCP_RAW=1
