{
  "name": "bring-mcp-catalog",
  "version": "0.2.0",
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "scripts": {
    "test": "npm run format && eslint . --ext .ts --fix && NODE_OPTIONS=--experimental-vm-modules jest",
    "lint:ci": "prettier --check . && eslint . --ext .ts",
    "test:ci": "npm run lint:ci && NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "build": "tsc",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest",
    "clean": "rm -rf node_modules package-lock.json build",
    "rebuild": "npm run clean && npm install && npm run build",
    "format": "prettier --write ."
  },
  "keywords": [
    "bring",
    "claude",
    "mcp",
    "model-context-protocol",
    "modelcontextprotocol",
    "shopping",
    "shopping-list"
  ],
  "author": "SpellsPT",
  "license": "MIT",
  "description": "MCP server for Bring! shopping lists with catalog resolution: saves items under their canonical Bring! ids so they render in every language with the right icon and aisle.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpellsPT/bring-mcp-catalog.git"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "build/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "bring-mcp-catalog": "build/src/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "bring-shopping": "^2.0.1",
    "dotenv": "^17.4.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  },
  "homepage": "https://github.com/SpellsPT/bring-mcp-catalog#readme",
  "bugs": {
    "url": "https://github.com/SpellsPT/bring-mcp-catalog/issues"
  }
}
